{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.makers-anvil.local/tool-detection.schema.json",
  "title": "Makers Anvil read-only tool detection",
  "type": "object",
  "required": ["schemaVersion", "claimState", "mode", "platform", "summary", "familyCoverage", "tools", "safety", "actions"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {"const": "makers-anvil.api.tool-detection.v1"},
    "claimState": {"$ref": "claim-state.schema.json"},
    "mode": {"const": "read-only-presence"},
    "platform": {
      "type": "object",
      "required": ["id", "claimState"],
      "additionalProperties": false,
      "properties": {
        "id": {"enum": ["windows", "macos", "linux", "unknown"]},
        "claimState": {"$ref": "claim-state.schema.json"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["toolCount", "detectedCount", "notDetectedCount"],
      "additionalProperties": false,
      "properties": {
        "toolCount": {"type": "integer", "minimum": 0},
        "detectedCount": {"type": "integer", "minimum": 0},
        "notDetectedCount": {"type": "integer", "minimum": 0}
      }
    },
    "familyCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "detectedToolCount", "claimState"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "detectedToolCount": {"type": "integer", "minimum": 0},
          "claimState": {"$ref": "claim-state.schema.json"}
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "publisher", "families", "claimState", "detection", "version", "actionsEnabled"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "publisher": {"type": "string"},
          "families": {"type": "array", "items": {"type": "string"}},
          "claimState": {"$ref": "claim-state.schema.json"},
          "detection": {
            "type": "object",
            "required": ["installed", "method", "candidateId", "executableName", "absolutePathExposed"],
            "additionalProperties": false,
            "properties": {
              "installed": {"type": "boolean"},
              "method": {"enum": ["path-command", "standard-location", "none"]},
              "candidateId": {"type": ["string", "null"]},
              "executableName": {"type": ["string", "null"]},
              "absolutePathExposed": {"const": false}
            }
          },
          "version": {
            "type": "object",
            "required": ["claimState", "value", "commandExecuted"],
            "additionalProperties": false,
            "properties": {
              "claimState": {"const": "not proven"},
              "value": {"const": null},
              "commandExecuted": {"const": false}
            }
          },
          "actionsEnabled": {"const": false}
        }
      }
    },
    "safety": {"$ref": "tool-catalog.schema.json#/$defs/safety"},
    "actions": {
      "type": "object",
      "required": ["launch", "install", "update", "uninstall", "repair"],
      "additionalProperties": false,
      "properties": {
        "launch": {"$ref": "#/$defs/blockedAction"},
        "install": {"$ref": "#/$defs/blockedAction"},
        "update": {"$ref": "#/$defs/blockedAction"},
        "uninstall": {"$ref": "#/$defs/blockedAction"},
        "repair": {"$ref": "#/$defs/blockedAction"}
      }
    }
  },
  "$defs": {
    "blockedAction": {
      "type": "object",
      "required": ["claimState", "enabledInApi"],
      "additionalProperties": false,
      "properties": {
        "claimState": {"const": "blocked"},
        "enabledInApi": {"const": false}
      }
    }
  }
}
