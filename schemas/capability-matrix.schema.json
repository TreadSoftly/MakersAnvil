{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.makers-anvil.local/capability-matrix.schema.json",
  "title": "Makers Anvil capability matrix",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "claimState", "summary", "ingressMethods", "lanes", "honesty", "safety"],
  "properties": {
    "schemaVersion": {"const": "makers-anvil.api.capability-matrix.v1"}, "claimState": {"enum": ["staged", "preview-only"]},
    "summary": {"type": "object", "additionalProperties": false, "required": ["laneCount", "supportedInputCount", "previewReadyLaneCount", "detectedToolCount", "plannedOutputCount"], "properties": {"laneCount": {"const": 5}, "supportedInputCount": {"type": "integer", "minimum": 1}, "previewReadyLaneCount": {"type": "integer", "minimum": 0, "maximum": 5}, "detectedToolCount": {"type": "integer", "minimum": 0}, "plannedOutputCount": {"type": "integer", "minimum": 0}}},
    "ingressMethods": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "claimState", "enabled"], "properties": {"id": {"type": "string"}, "label": {"type": "string"}, "claimState": {"$ref": "claim-state.schema.json"}, "enabled": {"type": "boolean"}}}},
    "lanes": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["id", "label", "claimState", "status", "currentCount", "inputExamples", "route", "toolSummary", "tools", "plannedOutputCount", "whatWorks", "nextStep", "executionReady"], "properties": {"id": {"enum": ["mesh", "cad", "image", "toolpath", "document"]}, "label": {"type": "string"}, "claimState": {"enum": ["staged", "preview-only"]}, "status": {"enum": ["available", "preview-ready"]}, "currentCount": {"type": "integer", "minimum": 0}, "inputExamples": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^\\."}}, "route": {"type": "object"}, "toolSummary": {"type": "object"}, "tools": {"type": "array"}, "plannedOutputCount": {"type": "integer", "minimum": 0}, "whatWorks": {"type": "string"}, "nextStep": {"type": "string"}, "executionReady": {"const": false}}}},
    "honesty": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "safety": {"type": "object", "additionalProperties": {"const": false}}
  }
}
