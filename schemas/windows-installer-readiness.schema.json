{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.makers-anvil.local/windows-installer-readiness.schema.json",
  "title": "Makers Anvil Windows installer readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "claimState", "mode", "summary", "package", "identity", "upgrade", "removal", "signing", "gates", "actions", "safety"],
  "properties": {
    "schemaVersion": {"const": "makers-anvil.api.windows-installer-readiness.v1"},
    "claimState": {"const": "staged"},
    "mode": {"const": "read-only-installer-foundation"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["gateCount", "passedGateCount", "blockedGateCount", "foundationReady", "installerReady", "releaseReady"],
      "properties": {
        "gateCount": {"const": 9}, "passedGateCount": {"type": "integer", "minimum": 0, "maximum": 9},
        "blockedGateCount": {"type": "integer", "minimum": 0, "maximum": 9},
        "foundationReady": {"const": true}, "installerReady": {"const": false}, "releaseReady": {"const": false}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "payloadArtifact", "installerArtifact", "scope", "elevationRequired", "installLocation"],
      "properties": {
        "format": {"const": "msix"}, "payloadArtifact": {"const": "artifacts/windows/MakersAnvil.exe"},
        "installerArtifact": {"const": "artifacts/windows/MakersAnvil.msix"}, "scope": {"const": "per-user"},
        "elevationRequired": {"const": false}, "installLocation": {"const": "windows-managed-package-location"}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "displayName", "publisher", "publisherDisplayName", "version", "locked"],
      "properties": {
        "name": {"const": "TreadSoftly.MakersAnvil"}, "displayName": {"const": "Makers Anvil"},
        "publisher": {"const": "not-proven"}, "publisherDisplayName": {"const": "TreadSoftly"},
        "version": {"const": "0.1.0.0"}, "locked": {"const": false}
      }
    },
    "upgrade": {
      "type": "object", "additionalProperties": false,
      "required": ["sameIdentityRequired", "higherVersionRequired", "downgradeAllowed", "preserveUserData", "executionEnabled"],
      "properties": {"sameIdentityRequired": {"const": true}, "higherVersionRequired": {"const": true}, "downgradeAllowed": {"const": false}, "preserveUserData": {"const": true}, "executionEnabled": {"const": false}}
    },
    "removal": {
      "type": "object", "additionalProperties": false,
      "required": ["preserveUserDataByDefault", "explicitPurgeConsentRequired", "userDataPurgeEnabled", "executionEnabled"],
      "properties": {"preserveUserDataByDefault": {"const": true}, "explicitPurgeConsentRequired": {"const": true}, "userDataPurgeEnabled": {"const": false}, "executionEnabled": {"const": false}}
    },
    "signing": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredForInstallation", "productionMethod", "certificatePresent", "publisherMatched", "signatureVerified", "timestampVerified"],
      "properties": {"requiredForInstallation": {"const": true}, "productionMethod": {"const": "not-selected"}, "certificatePresent": {"const": false}, "publisherMatched": {"const": false}, "signatureVerified": {"const": false}, "timestampVerified": {"const": false}}
    },
    "gates": {
      "type": "array", "minItems": 9, "maxItems": 9,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "label", "claimState", "passed", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1},
          "claimState": {"$ref": "claim-state.schema.json"}, "passed": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "actions": {
      "type": "object", "additionalProperties": false,
      "required": ["foundationInspectionEnabled", "harnessInspectionEnabled", "installerBuildEnabled", "installerExecutionEnabled", "upgradeExecutionEnabled", "uninstallExecutionEnabled", "repairExecutionEnabled", "signingEnabled", "publishingEnabled", "apiMutationEnabled", "browserMutationEnabled"],
      "properties": {
        "foundationInspectionEnabled": {"const": true}, "harnessInspectionEnabled": {"const": true},
        "installerBuildEnabled": {"const": false}, "installerExecutionEnabled": {"const": false}, "upgradeExecutionEnabled": {"const": false},
        "uninstallExecutionEnabled": {"const": false}, "repairExecutionEnabled": {"const": false}, "signingEnabled": {"const": false},
        "publishingEnabled": {"const": false}, "apiMutationEnabled": {"const": false}, "browserMutationEnabled": {"const": false}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["networkAccessEnabled", "registryMutationEnabled", "certificateStoreMutationEnabled", "packageRegistrationEnabled", "softwareMutationEnabled", "externalProcessEnabled", "userDataDeletionEnabled", "releasePublicationEnabled"],
      "properties": {
        "networkAccessEnabled": {"const": false}, "registryMutationEnabled": {"const": false}, "certificateStoreMutationEnabled": {"const": false},
        "packageRegistrationEnabled": {"const": false}, "softwareMutationEnabled": {"const": false}, "externalProcessEnabled": {"const": false},
        "userDataDeletionEnabled": {"const": false}, "releasePublicationEnabled": {"const": false}
      }
    }
  }
}
